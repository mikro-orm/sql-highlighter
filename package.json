{
  "name": "@mikro-orm/sql-highlighter",
  "version": "1.0.0",
  "description": "Node.js SQL highlighter for CLI based on doctrine/sql-formatter.",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mikro-orm/sql-highlighter.git"
  },
  "keywords": [
    "sql",
    "nodejs",
    "highlight",
    "tokenizer"
  ],
  "author": "Martin Adámek",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mikro-orm/sql-highlighter/issues"
  },
  "homepage": "https://mikro-orm.io",
  "engines": {
    "node": ">= 10.13.0"
  },
  "scripts": {
    "build": "yarn clean && yarn compile && yarn copy",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.json",
    "copy": "node ./scripts/copy.js",
    "lint": "oxlint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "ansi-colors": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "^1.81.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
