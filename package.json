{
  "name": "@mikro-orm/sql-highlighter",
  "version": "1.0.0",
  "description": "Node.js SQL highlighter for CLI based on doctrine/sql-formatter.",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mikro-orm/sql-highlighter.git"
  },
  "keywords": [
    "sql",
    "nodejs",
    "highlight",
    "tokenizer"
  ],
  "author": "Martin Adámek",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mikro-orm/sql-highlighter/issues"
  },
  "homepage": "https://mikro-orm.io",
  "engines": {
    "node": ">= 10.13.0"
  },
  "scripts": {
    "build": "yarn clean && yarn compile && yarn copy",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.json",
    "copy": "node ./scripts/copy.js",
    "lint": "oxlint src tests",
    "test": "jest"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": "@swc/jest"
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts"
    ],
    "modulePathIgnorePatterns": [
      "dist/package.json",
      "<rootDir>/package.json"
    ]
  },
  "dependencies": {
    "ansi-colors": "^4.1.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.5.1",
    "oxlint": "^1.81.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@1.22.22"
}
