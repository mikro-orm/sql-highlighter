{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2017",
    "moduleResolution": "nodenext",
    "declaration": true,
    "sourceMap": false,
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "exclude": [
    "**/node_modules",
    "**/dist"
  ],
  "include": [
    "src/**/*"
  ]
}
